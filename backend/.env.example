PORT=5000
MONGODB_URI=mongodb://localhost:27017/ecodrive
JWT_SECRET=ecodrive_jwt_secret_key_production_grade_2026
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Free Maps & Geocoding API Configuration
# Provider: 'openstreetmap' (Default, 100% free, no key required)
# Or use free tier API keys: 'locationiq' (5,000 req/day free), 'geoapify' (3,000 req/day free), 'mapbox'
MAPS_PROVIDER=openstreetmap
MAPS_API_KEY=
